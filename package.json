{
  "name": "honeyguard",
  "private": true,
  "version": "0.1.0-alpha",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:confusables && tsc --noEmit && vite build",
    "generate:confusables": "node scripts/generate-confusables.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:confusables": "node scripts/generate-confusables.mjs --check",
    "verify:windows-eol": "node scripts/verify-windows-eol.mjs"
  },
  "dependencies": {
    "punycode": "2.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldts": "7.4.18"
  },
  "devDependencies": {
    "@types/punycode": "2.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
